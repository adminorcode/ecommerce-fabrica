{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "petshop/product-grid",
  "version": "0.1.0",
  "title": "Vitrine de produtos",
  "category": "petshop",
  "icon": "products",
  "description": "Grade dinâmica de produtos configurável por seleção manual, categoria, popularidade ou sazonalidade.",
  "textdomain": "petshop-core",
  "attributes": {
    "selectionMode": { "type": "string", "default": "popular" },
    "productIds": { "type": "array", "items": { "type": "number" }, "default": [] },
    "categoryIds": { "type": "array", "items": { "type": "number" }, "default": [] },
    "limit": { "type": "number", "default": 4 },
    "columns": { "type": "number", "default": 4 },
    "orderby": { "type": "string", "default": "date" },
    "order": { "type": "string", "default": "DESC" }
  },
  "supports": {
    "html": false,
    "align": ["wide", "full"],
    "spacing": {
      "margin": true,
      "padding": true
    }
  }
}
