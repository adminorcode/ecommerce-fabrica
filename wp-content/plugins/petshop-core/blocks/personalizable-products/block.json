{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "petshop/personalizable-products",
  "version": "0.1.0",
  "title": "Produtos personalizáveis",
  "category": "petshop",
  "icon": "art",
  "description": "Vitrine dinâmica com os produtos publicados que têm personalização habilitada.",
  "textdomain": "petshop-core",
  "attributes": {
    "limit": { "type": "number", "default": 8 },
    "columns": { "type": "number", "default": 4 },
    "productIds": { "type": "string", "default": "" },
    "categorySlugs": { "type": "string", "default": "" }
  },
  "supports": {
    "html": false,
    "align": ["wide", "full"],
    "spacing": {
      "margin": true,
      "padding": true
    }
  }
}
