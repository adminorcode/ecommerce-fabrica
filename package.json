{
  "name": "petshop-ecommerce",
  "version": "0.1.0",
  "private": true,
  "description": "E-commerce do petshop baseado em WordPress e WooCommerce.",
  "scripts": {
    "bootstrap": "docker compose up -d --build --wait",
    "up": "docker compose up --watch",
    "down": "docker compose down",
    "validate": "node scripts/run-gates.mjs",
    "test": "docker compose --profile test run --rm test-runner",
    "wp": "docker compose --profile tools run --rm --no-deps cli wp",
    "bootstrap:legacy": "node scripts/bootstrap-wp-env.mjs"
  },
  "engines": {
    "node": ">=20"
  }
}
